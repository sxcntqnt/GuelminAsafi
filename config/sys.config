[
  {himap_hann, [
    {port,         8080},
    {hnsw_dim,     128},    %% RegionDCL embedding dimension
    {hnsw_m,       16},     %% HNSW link density per layer
    {hnsw_ef,      64},     %% beam width during construction
    {hnsw_dist_fn, cosine}  %% cosine | euclidean
  ]},

  %% ── Marina (ScyllaDB native CQL protocol) ────────────────────────
  %% Marina uses a fixed-size pool of async socket connections.
  %% Run schema migrations first (see priv/schema.cql) before starting.
  {marina, [
    {backlog_size,     4096},          %% max in-flight requests per socket
    {bootstrap_ips,    ["127.0.0.1"]}, %% ScyllaDB seed nodes
    {keyspace,         "himap"},       %% default keyspace for all queries
    {port,             9042},          %% CQL native protocol port
    {pool_size,        16},            %% connections in the pool
    {requests_timeout, 5000}           %% ms per synchronous call
  ]},

  {kernel, [
    {logger_level, info},
    {logger, [
      {handler, default, logger_std_h,
        #{formatter => {logger_formatter,
            #{template => [time, " [", level, "] ", msg, "\n"]}}}}
    ]}
  ]}
].
